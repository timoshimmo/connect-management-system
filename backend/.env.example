NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (credentials: true, so no wildcard)
FRONTEND_URL=http://localhost:5173

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/management_app

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 (document/drawing file storage — S3-compatible via AWS SDK v3)
# R2_ACCOUNT_ID: your Cloudflare account id (R2 dashboard URL or Account Home)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token (R2 → Manage API Tokens)
# R2_BUCKET_NAME: the bucket created for this app
# R2_PUBLIC_BASE_URL: the bucket's public base URL (Settings → Public access —
#   either the r2.dev subdomain or a connected custom domain), no trailing slash
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=management-system
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Email (password reset, etc.) — Zoho Mail SMTP by default. Leave all of
# these blank to fall back to logging the email instead of sending it
# (fine for local dev). SMTP_USER/SMTP_PASS are your full Zoho address and
# an app-specific password (Zoho Mail → Settings → Security → App
# Passwords) — use an app password, not your real account password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@zoho.com
SMTP_PASS=your-zoho-app-password
SMTP_FROM=your-address@zoho.com

# Microsoft Entra ID (Azure AD) SSO — optional. Leave all three blank to
# disable Microsoft sign-in entirely (the frontend hides the "Sign in with
# Microsoft" button and the SSO routes respond "not configured" instead of
# the app failing to start — see config/env.js's microsoft.enabled flag and
# utils/mailer.js's identical optional-feature pattern).
#
# Set these up in the Azure Portal under Microsoft Entra ID → App
# registrations → New registration:
#   MICROSOFT_TENANT_ID: the tenant (Directory) ID — restricts sign-in to
#     your organization's own Entra tenant only. Do not use "common" unless
#     you intend to allow any Microsoft account to sign in.
#   MICROSOFT_CLIENT_ID: the App registration's Application (client) ID
#   MICROSOFT_CLIENT_SECRET: a client secret from Certificates & secrets
#   MICROSOFT_REDIRECT_URI: must exactly match a Redirect URI configured on
#     the App registration (Authentication → Web → Redirect URIs), e.g.
#     https://your-domain.com/api/auth/microsoft/callback
# Also add the API permission "email", "openid", "profile" (Microsoft
# Graph → Delegated permissions) if not already granted by default.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
