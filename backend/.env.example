NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (credentials: true, so no wildcard)
FRONTEND_URL=http://localhost:5173

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/management_app

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 (document/drawing file storage — S3-compatible via AWS SDK v3)
# R2_ACCOUNT_ID: your Cloudflare account id (R2 dashboard URL or Account Home)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token (R2 → Manage API Tokens)
# R2_BUCKET_NAME: the bucket created for this app
# R2_PUBLIC_BASE_URL: the bucket's public base URL (Settings → Public access —
#   either the r2.dev subdomain or a connected custom domain), no trailing slash
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=management-system
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
